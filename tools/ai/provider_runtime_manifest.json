{
  "manifest_version": 1,
  "schema": "org.flux.ai.provider-runtime-manifest.v1",
  "runtimes": [
    {
      "id": "sam3",
      "display_name": "SAM3 Transformers provider runtime",
      "provider": "Meta SAM / Hugging Face Transformers",
      "models": [
        "sam3_transformers"
      ],
      "env_dir_name": "sam3",
      "python": {
        "supported_min": "3.10",
        "supported_max_exclusive": "3.14",
        "override_env": "FLUX_AI_PYTHON"
      },
      "install_policy": "external_per_provider_venv_no_model_downloads",
      "packages": [
        "torch",
        "torchvision",
        "transformers",
        "accelerate",
        "huggingface_hub",
        "pillow",
        "numpy",
        "opencv-python-headless"
      ],
      "cuda": {
        "default": "cu128",
        "indices": {
          "cu128": "https://download.pytorch.org/whl/cu128",
          "cu126": "https://download.pytorch.org/whl/cu126",
          "cpu": "https://download.pytorch.org/whl/cpu"
        }
      },
      "self_check": {
        "script": "tools/ai/sam3_transformers_real_inference_probe.py",
        "args": [
          "--self-check",
          "--json"
        ]
      },
      "launch": {
        "python_kind": "venv",
        "venv_dir": "venv"
      }
    },
    {
      "id": "matanyone2",
      "display_name": "MatAnyone2 provider runtime",
      "provider": "MatAnyone2",
      "models": [
        "matanyone2"
      ],
      "env_dir_name": "matanyone2",
      "python": {
        "supported_min": "3.10",
        "supported_max_exclusive": "3.14",
        "override_env": "FLUX_MATANYONE2_PYTHON"
      },
      "install_policy": "external_per_provider_venv_no_model_downloads",
      "packages": [
        "torch",
        "torchvision",
        "transformers",
        "accelerate",
        "huggingface_hub",
        "pillow",
        "numpy",
        "opencv-python-headless",
        "safetensors",
        "hydra-core",
        "omegaconf",
        "easydict",
        "einops",
        "kornia",
        "scipy",
        "hickle",
        "thinplate@git+https://github.com/cheind/py-thin-plate-spline",
        "av",
        "imageio==2.25.0",
        "imageio[ffmpeg]",
        "requests",
        "xlsxwriter"
      ],
      "cuda": {
        "default": "cu128",
        "indices": {
          "cu128": "https://download.pytorch.org/whl/cu128",
          "cu126": "https://download.pytorch.org/whl/cu126",
          "cpu": "https://download.pytorch.org/whl/cpu"
        }
      },
      "self_check": {
        "script": "tools/ai/matanyone2_worker.py",
        "args": [
          "--self-check"
        ],
        "extra_imports": [
          "torch",
          "matanyone2",
          "numpy",
          "PIL"
        ]
      },
      "launch": {
        "python_kind": "venv",
        "venv_dir": "venv"
      },
      "source_checkouts": [
        {
          "module": "matanyone2",
          "repo": "https://github.com/pq-yang/MatAnyone2.git",
          "revision": "e3370127319c63a6dc8a49c69de2d41d90137f91",
          "path": "src/MatAnyone2"
        }
      ]
    },
    {
      "id": "videomama",
      "display_name": "VideoMaMa provider runtime",
      "provider": "VideoMaMa / Stable Video Diffusion",
      "models": [
        "videomama"
      ],
      "env_dir_name": "videomama",
      "python": {
        "supported_min": "3.10",
        "supported_max_exclusive": "3.14",
        "override_env": "FLUX_VIDEOMAMA_PYTHON"
      },
      "install_policy": "external_per_provider_venv_no_model_downloads",
      "packages": [
        "torch",
        "torchvision",
        "diffusers>=0.24.0",
        "accelerate",
        "safetensors",
        "pillow",
        "numpy",
        "opencv-python-headless"
      ],
      "cuda": {
        "default": "cu128",
        "indices": {
          "cu128": "https://download.pytorch.org/whl/cu128",
          "cu126": "https://download.pytorch.org/whl/cu126",
          "cpu": "https://download.pytorch.org/whl/cpu"
        }
      },
      "self_check": {
        "script": "tools/ai/videomama_worker.py",
        "args": [
          "--self-check"
        ],
        "extra_imports": [
          "torch",
          "diffusers",
          "safetensors",
          "numpy",
          "PIL"
        ]
      },
      "launch": {
        "python_kind": "venv",
        "venv_dir": "venv"
      }
    },
    {
      "id": "sam31",
      "display_name": "SAM3.1 provider runtime",
      "provider": "Meta SAM",
      "models": [
        "sam31_sam3plus"
      ],
      "env_dir_name": "sam31",
      "python": {
        "supported_min": "3.10",
        "supported_max_exclusive": "3.14",
        "override_env": "FLUX_AI_PYTHON"
      },
      "install_policy": "external_per_provider_venv_no_model_downloads",
      "packages": [
        "torch",
        "torchvision",
        "transformers",
        "accelerate",
        "huggingface_hub",
        "pillow",
        "numpy",
        "opencv-python-headless"
      ],
      "cuda": {
        "default": "cu128",
        "indices": {
          "cu128": "https://download.pytorch.org/whl/cu128",
          "cu126": "https://download.pytorch.org/whl/cu126",
          "cpu": "https://download.pytorch.org/whl/cpu"
        }
      },
      "self_check": {
        "script": "tools/ai/sam31_real_inference_probe.py",
        "args": [
          "--self-check",
          "--json"
        ]
      },
      "launch": {
        "python_kind": "venv",
        "venv_dir": "venv"
      }
    }
  ]
}
