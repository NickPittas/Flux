      "default_enabled": false,
      "default_installable": true,
      "implemented": true,
      "output_use_notes": "Create a native CorridorKey node from an existing Result History mask. Installer/runtime stages user-supplied or locally available TensorRT engines and TensorRT runtime libraries; Flux still does not bundle CorridorKey source or claim commercial clearance.",
      "source": {
