/* -*- mode: css -*- */
/* Flux Dark Theme
 * Runtime substitutions from Gui::loadFluxStyleSheet():
 *   %1  accent
 *   %2  base surface
 *   %3  raised surface
 *   %4  recessed surface / borders
 *   %5  primary text
 *   %6  interpolated state
 *   %7  keyframe state
 *   %8  disabled text
 *   %9  expression state
 *   %10 altered text
 *   %11 hover accent
 */

/* ── Global surfaces ─────────────────────────────────────────────── */

QWidget {
    color: %5;
    background-color: %2;
}

QFrame,
QLabel {
    color: %5;
}

QMainWindow,
QDialog,
QScrollArea,
QGraphicsView,
QAbstractScrollArea {
    background-color: %4;
}

QToolTip {
    color: %5;
    background-color: %4;
    border: 1px solid #1c212a;
    border-radius: 4px;
    padding: 4px 6px;
    opacity: 235;
}

Label[altered="true"],
Natron--Label[altered="true"] {
    color: %10;
}

Label[altered="false"],
Natron--Label[altered="false"] {
    color: %5;
}

/* ── Application chrome ──────────────────────────────────────────── */

QMenuBar {
    color: %5;
    background-color: %4;
    border: none;
}

QMenuBar::item {
    padding: 5px 10px;
    background-color: transparent;
}

QMenuBar::item:selected {
    color: #ffffff;
    background-color: %3;
    border-radius: 3px;
}

QMenu {
    color: %5;
    background-color: %4;
    border: 1px solid #1c212a;
    padding: 4px 0px;
    menu-scrollable: 1;
}

QMenu::item {
    padding: 5px 20px 5px 12px;
    background-color: transparent;
}

QMenu::item:selected {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
}

QMenu::item:disabled,
QMenu::item:!enabled {
    color: %8;
}

QMenu::separator {
    height: 1px;
    margin: 5px 10px;
    background: #1c212a;
}

QToolBar {
    color: %5;
    background-color: %4;
    spacing: 4px;
    border: none;
    padding: 2px 4px;
}

QToolButton,
ViewerToolButton,
Natron--ViewerToolButton {
    color: %5;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px;
}

QToolButton:hover,
ViewerToolButton:hover,
Natron--ViewerToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: transparent;
}

QToolButton:pressed,
QToolButton:checked,
ViewerToolButton[isSelected="true"],
Natron--ViewerToolButton[isSelected="true"],
ViewerToolButton:pressed,
Natron--ViewerToolButton:pressed {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.12);
    border-color: %1;
}

QToolButton:focus,
ViewerToolButton:focus,
Natron--ViewerToolButton:focus {
    border-color: %1;
}

QStatusBar {
    background-color: %4;
    color: %5;
    border: none;
}

QStatusBar::item {
    border: none;
}

/* ── Tabs ────────────────────────────────────────────────────────── */

TabWidget,
Natron--TabWidget {
    background-color: %4;
}

QTabWidget::pane {
    background-color: transparent;
    border: none;
    margin-top: 0px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    background: transparent;
    tabbar-prefer-no-arrows: false;
}

QTabBar::tab {
    color: #8c97a5;
    background: transparent;
    border: none;
    min-width: 4em;
    padding: 6px 14px 6px 14px;
    margin-right: 4px;
    font-weight: normal;
}

QTabBar::tab:hover {
    color: #dce6f3;
    background: transparent;
}

QTabBar::tab:selected {
    color: #ffffff;
    background: transparent;
    border: none;
    border-bottom: 2px solid %1;
    font-weight: normal;
}

QTabBar::tab#DockablePanelTabWidget,
QTabBar::tab#Natron--DockablePanelTabWidget,
QTabBar::tab#FluxPanelTabBar,
QTabBar::tab#FluxDockTabBar {
    min-width: 3em;
}

QTabBar::tab:only-one {
    margin-right: 4px;
}

QTabBar::close-button {
    image: none;
}

QTabBar::tab:hover QTabBar::close-button,
QTabBar::tab:selected QTabBar::close-button {
    image: url(:/Resources/Images/closeTab.png);
    subcontrol-position: right;
}

QTabBar::tab:hover QTabBar::close-button:hover,
QTabBar::tab:selected QTabBar::close-button:hover {
    image: url(:/Resources/Images/closeTab_hovered.png);
}


TabBar[mouseOverFocus="true"][clickFocus="false"],
Natron--TabBar[mouseOverFocus="true"][clickFocus="false"] {
    color: %11;
}

TabBar[clickFocus="true"],
Natron--TabBar[clickFocus="true"] {
    color: %1;
}

TabBar[mouseOverFocus="false"][clickFocus="false"],
Natron--TabBar[mouseOverFocus="false"][clickFocus="false"] {
    color: %5;
}

/* ── Group boxes / splitters / progress ──────────────────────────── */

QGroupBox {
    color: %5;
    background-color: transparent;
    border: 1px solid #303845;
    border-radius: 5px;
    margin-top: 8px;
    padding: 10px 6px 6px 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #d9e3f0;
}

QGroupBox::indicator:unchecked {
    width: 10px;
    height: 10px;
    image: url(:/Resources/Images/groupbox_folded.png);
}

QGroupBox::indicator:checked {
    width: 10px;
    height: 10px;
    image: url(:/Resources/Images/groupbox_unfolded.png);
}

QSplitter::handle:horizontal {
    background-color: %4;
    width: 4px;
}

QSplitter::handle:vertical {
    background-color: %4;
    height: 4px;
}

QSplitter::handle:hover {
    background-color: %1;
}

QProgressBar {
    color: #dfe9f5;
    background-color: #171b22;
    border: 1px solid #2c3643;
    border-radius: 4px;
    min-height: 16px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: %1;
    border-radius: 3px;
}

/* ── Lists, trees, tables, headers ───────────────────────────────── */

QTreeView,
QListView,
QTreeWidget,
QListWidget,
QTableView,
QTableWidget,
QAbstractItemView {
    color: %5;
    background-color: %4;
    alternate-background-color: #0e1217;
    selection-color: #ffffff;
    selection-background-color: #1a4d70;
    border: 1px solid #1c212a;
    border-radius: 4px;
    outline: none;
}

QTreeView::item,
QListView::item,
QTreeWidget::item,
QListWidget::item,
QTableView::item,
QTableWidget::item {
    min-height: 20px;
}

QTreeView::item:selected,
QListView::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
    color: #ffffff;
    background: #1a4d70;
}

QTreeView::item:hover,
QListView::item:hover,
QTreeWidget::item:hover,
QListWidget::item:hover,
QTableView::item:hover,
QTableWidget::item:hover {
    background: #242d39;
}

QTreeWidget::branch:selected {
    background: #1a4d70;
}

QTreeWidget::branch:has-siblings:!adjoins-item {
    border-image: url(:/Resources/Images/treeview_vline.png);
}

QTreeWidget::branch:has-siblings:adjoins-item {
    border-image: url(:/Resources/Images/treeview_more.png);
}

QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    border-image: url(:/Resources/Images/treeview_end.png);
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/Resources/Images/groupbox_folded.png);
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/Resources/Images/groupbox_unfolded.png);
}

QHeaderView {
    background-color: #0f131a;
    border: none;
}

QHeaderView:section {
    color: #aeb8c6;
    background-color: #0f131a;
    border: none;
    border-right: 1px solid #1a2029;
    border-bottom: 1px solid #1a2029;
    padding: 5px 8px;
    font-weight: normal;
}

/* ── Scroll bars ─────────────────────────────────────────────────── */

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #404b59;
    min-height: 28px;
    border-radius: 4px;
    margin: 1px 1px;
}

QScrollBar::handle:vertical:hover {
    background: #5a6e80;
}

QScrollBar::handle:vertical:pressed {
    background: %1;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #404b59;
    min-width: 28px;
    border-radius: 4px;
    margin: 1px 1px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a6e80;
}

QScrollBar::handle:horizontal:pressed {
    background: %1;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

/* ── Buttons ─────────────────────────────────────────────────────── */

QPushButton,
Button,
Natron--Button {
    color: #c9d1d9;
    background-color: transparent;
    border: 1px solid #222933;
    border-radius: 4px;
    padding: 2px 8px;
    min-height: 18px;
}

QPushButton:hover,
Button:hover,
Natron--Button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: #3d495a;
    color: #ffffff;
}

QPushButton:pressed,
QPushButton:checked,
Button:pressed,
Natron--Button:pressed {
    color: #ffffff;
    background-color: #1a4d70;
    border-color: %1;
}

QPushButton:focus,
Button:focus,
Natron--Button:focus {
    border-color: %1;
}

QPushButton:disabled,
QPushButton:!enabled,
Button:disabled,
Natron--Button:disabled {
    color: %8;
    background-color: transparent;
    border-color: #1c212a;
}

QPushButton#fluxPrimaryButton {
    color: #ffffff;
    background-color: #1a4d70;
    border: 1px solid %1;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 24px;
    font-weight: normal;
}

QPushButton#fluxPrimaryButton:hover {
    background-color: #22608c;
    border-color: %11;
}

QPushButton#fluxPrimaryButton:pressed,
QPushButton#fluxPrimaryButton:checked {
    background-color: #123853;
    border-color: %1;
}

QPushButton#fluxPrimaryButton:disabled,
QPushButton#fluxPrimaryButton:!enabled {
    color: #8a97a6;
    background-color: #1c212a;
    border-color: #2b3648;
}

/* ── Editors and selectors ───────────────────────────────────────── */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QAbstractSpinBox,
QSpinBox,
QDoubleSpinBox,
QComboBox,
ComboBox,
Natron--ComboBox {
    color: %5;
    background-color: %4;
    selection-color: #ffffff;
    selection-background-color: #1a4d70;
    border: 1px solid #1b2028;
    border-radius: 4px;
}

QLineEdit,
QAbstractSpinBox,
QSpinBox,
QDoubleSpinBox,
QComboBox,
ComboBox,
Natron--ComboBox {
    min-height: 22px;
    padding: 2px 8px;
}

QTextEdit,
QPlainTextEdit {
    padding: 4px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QAbstractSpinBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
ComboBox:focus,
Natron--ComboBox:focus {
    border-color: #3d4f68;
    background-color: %4;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QAbstractSpinBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover,
ComboBox:hover,
Natron--ComboBox:hover {
    border-color: #272e39;
}

QLineEdit:disabled,
QLineEdit:!enabled,
QTextEdit:disabled,
QTextEdit:!enabled,
QPlainTextEdit:disabled,
QPlainTextEdit:!enabled,
QAbstractSpinBox:disabled,
QAbstractSpinBox:!enabled,
QSpinBox:disabled,
QSpinBox:!enabled,
QDoubleSpinBox:disabled,
QDoubleSpinBox:!enabled,
QComboBox:disabled,
QComboBox:!enabled,
ComboBox:disabled,
Natron--ComboBox:disabled {
    color: %8;
    background-color: %4;
    border-color: #161b22;
}

QLineEdit:read-only,
QTextEdit:read-only,
QPlainTextEdit:read-only {
    color: #b6c0cd;
    background-color: #20252d;
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    width: 20px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #d4deea;
}

QComboBox QAbstractItemView,
ComboBoxMenu,
Natron--Menu {
    min-height: 22px;
    padding: 2px;
    border: 1px solid #394453;
    background-color: #1c2129;
    color: %5;
    selection-background-color: #31566c;
    selection-color: #ffffff;
    outline: none;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    width: 14px;
    border: none;
    background: #1a1f26;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #25323e;
}

QToolButton#ColorSelectorButton {
    border: 1px solid #394453;
    border-radius: 4px;
    padding: 0px;
}

QToolButton#ColorSelectorButton:menu-indicator {
    image: none;
}

QToolButton#ColorSelectorButton:hover {
    border-color: %1;
}

/* ── Slider / checkbox controls ──────────────────────────────────── */

QSlider {
    min-height: 22px;
}

QSlider::groove:horizontal {
    background: #1d232c;
    height: 2px;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background: #2b5c8f;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: #545c68;
    width: 8px;
    height: 8px;
    margin: -3px 0;
    border-radius: 4px;
    border: 1px solid #11151c;
}

QSlider::handle:horizontal:hover {
    background: #8b949e;
    border-color: %1;
}

QSlider::groove:vertical {
    background: #1d232c;
    width: 2px;
    border-radius: 1px;
}

QSlider::sub-page:vertical {
    background: #2b5c8f;
    border-radius: 1px;
}

QSlider::handle:vertical {
    background: #545c68;
    width: 8px;
    height: 8px;
    margin: 0 -3px;
    border-radius: 4px;
    border: 1px solid #11151c;
}

QSlider::handle:vertical:hover {
    background: #8b949e;
    border-color: %1;
}

QCheckBox {
    color: %5;
    min-height: 22px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #2a323d;
    border-radius: 3px;
    background-color: %4;
}

QCheckBox::indicator:hover {
    border-color: #3d4a5c;
    background-color: %4;
}

QCheckBox::indicator:checked {
    border-color: %1;
    background-color: %1;
    image: none;
}

AnimatedCheckBox,
Natron--AnimatedCheckBox {
    min-width: 18px;
    min-height: 18px;
    max-width: 18px;
    max-height: 18px;
    border: 1px solid #5a6575;
    border-radius: 3px;
    background-color: #232a34;
}

AnimatedCheckBox:focus,
Natron--AnimatedCheckBox:focus {
    border-color: %1;
}

ScaleSliderQWidget,
Natron--ScaleSliderQWidget {
    min-height: 28px;
    background-color: transparent;
}

/* ── Animation / dirty / altered semantics ───────────────────────── */

ClickableLabel[dirty="false"][animation="0"][sunkenStyle="false"],
Natron--ClickableLabel[dirty="false"][animation="0"][sunkenStyle="false"] {
    background-color: #1f252d;
}

ClickableLabel[dirty="false"][animation="0"][sunkenStyle="true"],
Natron--ClickableLabel[dirty="false"][animation="0"][sunkenStyle="true"] {
    background-color: #262d38;
}

ClickableLabel[dirty="true"],
Natron--ClickableLabel[dirty="true"],
AnimatingTextEdit[dirty="true"],
Natron--AnimatingTextEdit[dirty="true"],
LineEdit[dirty="true"],
Natron--LineEdit[dirty="true"],
SpinBox[dirty="true"],
Natron--SpinBox[dirty="true"] {
    background-color: #2f3541;
    color: %5;
}

ClickableLabel[dirty="false"][animation="1"],
Natron--ClickableLabel[dirty="false"][animation="1"],
AnimatingTextEdit[animation="1"],
Natron--AnimatingTextEdit[animation="1"],
LineEdit[animation="1"],
Natron--LineEdit[animation="1"],
SpinBox[animation="1"],
Natron--SpinBox[animation="1"] {
    background-color: %6;
    color: #111418;
}

ClickableLabel[dirty="false"][animation="2"],
Natron--ClickableLabel[dirty="false"][animation="2"],
AnimatingTextEdit[animation="2"],
Natron--AnimatingTextEdit[animation="2"],
LineEdit[animation="2"],
Natron--LineEdit[animation="2"],
SpinBox[animation="2"],
Natron--SpinBox[animation="2"] {
    background-color: %7;
    color: #1a1710;
}

ClickableLabel[dirty="false"][animation="3"],
Natron--ClickableLabel[dirty="false"][animation="3"],
AnimatingTextEdit[animation="3"],
Natron--AnimatingTextEdit[animation="3"],
LineEdit[animation="3"],
Natron--LineEdit[animation="3"],
SpinBox[animation="3"],
Natron--SpinBox[animation="3"] {
    background-color: %9;
    color: #ffffff;
}

ClickableLabel[dirty="true"][animation="1"],
Natron--ClickableLabel[dirty="true"][animation="1"] {
    color: %6;
}

ClickableLabel[dirty="true"][animation="2"],
Natron--ClickableLabel[dirty="true"][animation="2"] {
    color: %7;
}

ClickableLabel[dirty="true"][animation="3"],
Natron--ClickableLabel[dirty="true"][animation="3"] {
    color: %9;
}

ClickableLabel[readOnly="true"][dirty="false"],
Natron--ClickableLabel[readOnly="true"][dirty="false"],
AnimatingTextEdit[readOnlyNatron="true"],
Natron--AnimatingTextEdit[readOnlyNatron="true"] {
    color: %8;
}

LineEdit[altered="true"],
Natron--LineEdit[altered="true"],
SpinBox[altered="true"][dirty="false"],
Natron--SpinBox[altered="true"][dirty="false"],
KnobClickableLabel[altered="true"],
Natron--KnobClickableLabel[altered="true"] {
    color: %10;
}

/* ── Properties / Natron panels ──────────────────────────────────── */

NodeSettingsPanel,
Natron--NodeSettingsPanel,
DockablePanel,
Natron--DockablePanel {
    background-color: %2;
    color: %5;
    border: 1px solid #1c212a;
    border-radius: 8px;
    padding: 4px;
}

NodeSettingsPanel[_selected="true"],
Natron--NodeSettingsPanel[_selected="true"] {
    border-color: %1;
}

NodeSettingsPanel[_selected="false"],
Natron--NodeSettingsPanel[_selected="false"] {
    border-color: #1c212a;
}

KnobClickableLabel,
Natron--KnobClickableLabel,
ClickableLabel,
Natron--ClickableLabel {
    min-height: 20px;
    padding: 1px 3px;
    color: %5;
}

DockablePanel QLineEdit,
Natron--DockablePanel QLineEdit,
DockablePanel LineEdit,
Natron--DockablePanel LineEdit,
DockablePanel SpinBox,
Natron--DockablePanel SpinBox,
DockablePanel QSpinBox,
Natron--DockablePanel QSpinBox,
DockablePanel QDoubleSpinBox,
Natron--DockablePanel QDoubleSpinBox,
DockablePanel QComboBox,
Natron--DockablePanel QComboBox,
DockablePanel ComboBox,
Natron--DockablePanel ComboBox,
NodeSettingsPanel QLineEdit,
Natron--NodeSettingsPanel QLineEdit,
NodeSettingsPanel LineEdit,
Natron--NodeSettingsPanel LineEdit,
NodeSettingsPanel SpinBox,
Natron--NodeSettingsPanel SpinBox,
NodeSettingsPanel QSpinBox,
Natron--NodeSettingsPanel QSpinBox,
NodeSettingsPanel QDoubleSpinBox,
Natron--NodeSettingsPanel QDoubleSpinBox,
NodeSettingsPanel QComboBox,
Natron--NodeSettingsPanel QComboBox,
NodeSettingsPanel ComboBox,
Natron--NodeSettingsPanel ComboBox {
    min-height: 24px;
    min-width: 52px;
}

DockablePanel QComboBox,
Natron--DockablePanel QComboBox,
DockablePanel ComboBox,
Natron--DockablePanel ComboBox,
NodeSettingsPanel QComboBox,
Natron--NodeSettingsPanel QComboBox,
NodeSettingsPanel ComboBox,
Natron--NodeSettingsPanel ComboBox {
    min-width: 88px;
}

DockablePanel QPushButton,
Natron--DockablePanel QPushButton,
DockablePanel Button,
Natron--DockablePanel Button,
NodeSettingsPanel QPushButton,
Natron--NodeSettingsPanel QPushButton,
NodeSettingsPanel Button,
Natron--NodeSettingsPanel Button {
    min-height: 20px;
    min-width: 20px;
    padding: 1px 6px;
}

/* ── Script editor defaults ──────────────────────────────────────── */

OutputScriptTextEdit,
Natron--OutputScriptTextEdit,
Natron--OutputScriptTextEdit[plainText] {
    color: #d3dbe7;
    background-color: #171b22;
    selection-color: #ffffff;
    selection-background-color: #31566c;
}

QTextEdit[html],
QTextEdit[plainText],
QTextBrowser[html],
QTextBrowser[plainText] {
    color: %5;
}

/* ── Scoped Flux shell accents ───────────────────────────────────── */

#FluxProjectBin,
#FluxAiPanel,
#FluxTextPanel,
#FluxTextAnimatorPanel,
#FluxScriptEditor,
#FluxExportPanel {
    border-radius: 0px;
}

#FluxProjectBin {
    background-color: %2;
    border: none;
}

#FluxProjectBin QLabel#fluxPanelHeader {
    color: %5;
    font-weight: normal;
}

#FluxProjectBin QTreeWidget,
#FluxProjectBin QTreeView {
    background-color: transparent;
    border: none;
}

#FluxProjectBin QLineEdit,
#FluxProjectBin QPushButton,
#FluxProjectBin QToolButton {
    background-color: %4;
    border: 1px solid #1c212a;
}

#FluxProjectBin QPushButton:hover,
#FluxProjectBin QToolButton:hover,
#FluxProjectBin QLineEdit:hover {
    border-color: #2b3648;
}

#FluxAiPanel {
    background-color: %2;
    border: none;
}

#FluxAiPanel QLabel#fluxPanelHeader,
#FluxAiPanel QLabel[fluxRole="sectionHeader"] {
    color: %5;
    font-weight: normal;
}

#FluxAiPanel #FluxAiHistoryList,
#FluxAiPanel #FluxAiLogOutput {
    background-color: %4;
    border: 1px solid #1c212a;
}

#FluxAiPanel #FluxAiRunButton,
#FluxAiPanel #FluxAiAddMaskButton,
#FluxAiPanel #FluxAiReplaceMaskButton {
    background-color: #1a4d70;
    border-color: %1;
    color: #ffffff;
}

#FluxAiPanel #FluxAiRunButton:hover,
#FluxAiPanel #FluxAiAddMaskButton:hover,
#FluxAiPanel #FluxAiReplaceMaskButton:hover {
    background-color: #22608c;
    border-color: %11;
}

#FluxAiPanel QProgressBar::chunk {
    background-color: %1;
}

#FluxTextPanel,
#FluxTextAnimatorPanel {
    background-color: %2;
    border: none;
}

#FluxTextPanel #FluxTextTextEdit,
#FluxTextPanel #FluxTextFontDropdownList,
#FluxTextPanel #FluxTextFillButton,
#FluxTextAnimatorPanel #FluxTextAnimatorNameEdit {
    background-color: %4;
    border-color: #1c212a;
}
#FluxTextPanel [fluxKeyButton=\"true\"],
#FluxTextAnimatorPanel [fluxKeyButton=\"true\"] {
    min-width: 20px;
    padding: 0px;
}

#FluxTextAnimatorPanel QGroupBox[fluxAnimatorCard=\"true\"] {
    background-color: #1e2632;
    border: 1px solid #334559;
    border-radius: 5px;
}

#FluxTextAnimatorPanel QGroupBox[fluxAnimatorCard=\"true\"][selected=\"true\"] {
    background-color: #223244;
    border-color: %1;
}

#FluxTextAnimatorPanel #FluxTextAnimatorHeader {
    background-color: transparent;
}

#FluxTextAnimatorPanel QPushButton[fluxAnimatorAction=\"remove\"] {
    background-color: #4a3134;
    border-color: #7d4f54;
}

#FluxTextAnimatorPanel QPushButton[fluxAnimatorAction=\"remove\"]:hover {
    border-color: #d68b91;
}

#FluxScriptEditor {
    background-color: %2;
    border: none;
}

#FluxScriptEditor #FluxScriptEditorToolbar {
    background-color: %4;
    border-bottom: 1px solid #1c212a;
}

#FluxScriptEditor #FluxScriptInput,
#FluxScriptEditor #FluxScriptOutput,
#FluxScriptLineNumberArea {
    background-color: %4;
    border-color: #1c212a;
}

#FluxPropertiesPanel,
#Properties,
#_propertiesContainer {
    background-color: %2;
}

#FluxPropertiesPanel {
    border: none;
}

#FluxPropertiesPanel NodeSettingsPanel,
#FluxPropertiesPanel Natron--NodeSettingsPanel,
#FluxPropertiesPanel DockablePanel,
#FluxPropertiesPanel Natron--DockablePanel {
    background-color: transparent;
    border: none;
}

#FluxDockablePanelHeader {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 2px 4px;
}

[fluxPanelHeaderButton="true"] {
    min-width: 22px;
    min-height: 22px;
    padding: 1px 2px;
    color: #b8bec6;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 7px;
}

[fluxPanelHeaderButton="true"]:hover {
    color: #e7ebf2;
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.07);
}

[fluxPanelHeaderButton="true"]:pressed,
[fluxPanelHeaderButton="true"]:checked {
    color: #f4f7fb;
    background-color: rgba(56, 113, 204, 0.18);
    border-color: rgba(56, 113, 204, 0.45);
}

#FluxDockablePanelNameEdit {
    color: %5;
    background-color: transparent;
    border: 1px solid transparent;
    font-size: 11pt;
    font-weight: normal;
    padding: 2px 4px;
}

#FluxDockablePanelNameEdit:focus {
    background-color: %4;
    border: 1px solid #3d4f68;
}

#FluxDockablePanelNameLabel {
    color: %5;
    font-size: 11pt;
    font-weight: normal;
    padding: 2px 4px;
}

#FluxExportPanel,
#FluxExportScrollArea,
#FluxExportContent {
    background-color: %2;
}

#FluxExportPanel {
    border: none;
}

#FluxExportPanel QGroupBox {
    background-color: %2;
    border-color: #1c212a;
}

#FluxExportPanel QLineEdit,
#FluxExportPanel LineEdit,
#FluxExportPanel SpinBox,
#FluxExportPanel ComboBox,
#FluxExportPanel Natron--ComboBox,
#FluxExportPanel QComboBox,
#FluxExportPanel QPushButton,
#FluxExportPanel Button,
#FluxExportPanel Natron--Button {
    background-color: %4;
    border-color: #1c212a;
}

#FluxExportPanel QPushButton:hover,
#FluxExportPanel Button:hover,
#FluxExportPanel Natron--Button:hover,
#FluxExportPanel QLineEdit:hover,
#FluxExportPanel QComboBox:hover {
    border-color: #2b3648;
}

#FluxViewerToolbar,
#FluxViewerInfoBar,
#FluxViewerTransport,
#FluxPanelTabWidget,
#FluxPanelTabBar,
#FluxDockTabBar,
TabWidget[fluxPaneRole=\"projectTabs\"],
TabWidget[fluxPaneRole=\"viewerTabs\"],
TabWidget[fluxPaneRole=\"inspectorTabs\"],
TabWidget[fluxPaneRole=\"timelineTabs\"],
QTabWidget[fluxPaneRole=\"propertiesTabs\"] {
    background-color: transparent;
}

#FluxViewerToolbar,
#FluxViewerInfoBar {
    background-color: #0f141a;
}

#FluxViewerTransport {
    background-color: #121820;
    border: 1px solid #1d2530;
    border-radius: 8px;
}

#FluxViewerToolbar Label,
#FluxViewerInfoBar Label,
#FluxViewerTransport Label,
#FluxViewerTransport ClickableLabel {
    color: #a8b0bb;
    background-color: transparent;
}

#FluxViewerToolbar ComboBox,
#FluxViewerToolbar QComboBox,
#FluxViewerInfoBar ComboBox,
#FluxViewerInfoBar QComboBox,
#FluxViewerTransport ComboBox,
#FluxViewerTransport QComboBox,
#FluxViewerTransport SpinBox,
#FluxViewerTransport QSpinBox,
#FluxViewerTransport QDoubleSpinBox {
    min-height: 22px;
    color: #d7dde7;
    background-color: #161c24;
    border: 1px solid #202834;
    border-radius: 7px;
    padding: 1px 8px;
}

#FluxViewerToolbar Button,
#FluxViewerToolbar QToolButton,
#FluxViewerToolbar ViewerToolButton,
#FluxViewerInfoBar Button,
#FluxViewerInfoBar QToolButton,
#FluxViewerTransport Button,
#FluxViewerTransport QToolButton {
    min-width: 24px;
    min-height: 24px;
    color: #b8bec6;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 7px;
    padding: 1px 2px;
}

#FluxViewerToolbar Button:hover,
#FluxViewerToolbar QToolButton:hover,
#FluxViewerToolbar ViewerToolButton:hover,
#FluxViewerInfoBar Button:hover,
#FluxViewerInfoBar QToolButton:hover,
#FluxViewerTransport Button:hover,
#FluxViewerTransport QToolButton:hover {
    color: #e7ebf2;
    background-color: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.07);
}

#FluxViewerToolbar Button:pressed,
#FluxViewerToolbar Button:checked,
#FluxViewerToolbar QToolButton:pressed,
#FluxViewerToolbar QToolButton:checked,
#FluxViewerToolbar ViewerToolButton[isSelected="true"],
#FluxViewerInfoBar Button:pressed,
#FluxViewerInfoBar Button:checked,
#FluxViewerTransport Button:pressed,
#FluxViewerTransport Button:checked,
